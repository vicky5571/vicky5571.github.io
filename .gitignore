# ==============================================================================
# Comprehensive .gitignore for Vite + React + Node.js Project
# Referenced from GitHub's official repository: https://github.com/github/gitignore
# (Node.gitignore, Global/macOS.gitignore, Global/Windows.gitignore,
#  Global/Linux.gitignore, Global/VisualStudioCode.gitignore, Global/JetBrains.gitignore)
# Extended via gitignore.io (https://www.toptal.com/developers/gitignore)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Project-Specific Paths
# ------------------------------------------------------------------------------
trash/
public/img/trash/

# ------------------------------------------------------------------------------
# 2. Dependencies & Package Managers (Node.gitignore)
# ------------------------------------------------------------------------------
node_modules/
jspm_packages/
web_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# ------------------------------------------------------------------------------
# 3. Production & Build Outputs
# ------------------------------------------------------------------------------
dist/
dist-ssr/
build/
out/
.next/
.nuxt/
.output/

# ------------------------------------------------------------------------------
# 4. Environment Variables & Credentials
# ------------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.*
!*.env.example

# ------------------------------------------------------------------------------
# 5. Logs & Runtime Data
# ------------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
pids
*.pid
*.seed
*.pid.lock

# ------------------------------------------------------------------------------
# 6. Caches & Temporary Storage
# ------------------------------------------------------------------------------
.cache/
.parcel-cache/
.vite/
.turbo/
.eslintcache
.stylelintcache
*.tsbuildinfo
.temp/
.tmp/
.npm/

# ------------------------------------------------------------------------------
# 7. Testing & Coverage
# ------------------------------------------------------------------------------
coverage/
*.lcov
.nyc_output/

# ------------------------------------------------------------------------------
# 8. Operating System Files (Global/macOS, Windows, Linux)
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
Network Trash Folder
Temporary Items
.apdisk
*.icloud

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ------------------------------------------------------------------------------
# 9. IDEs & Code Editors (Global/VisualStudioCode, JetBrains)
# ------------------------------------------------------------------------------
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
!*.code-workspace
.history/
*.vsix

# JetBrains IDEs (WebStorm, IntelliJ IDEA, PhpStorm, etc.)
.idea/
*.iws
*.iml
*.ipr

# Sublime Text
*.sublime-workspace
*.sublime-project

# Vim / Emacs backup files
*#*
.*.sw[a-z]
*.swp
*.swo

# ------------------------------------------------------------------------------
# 10. Packaging & Bundle Archives
# ------------------------------------------------------------------------------
*.tgz
*.tar.gz
*.zip